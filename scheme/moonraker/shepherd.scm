(define-module (moonraker shepherd)
  #:use-module (ice-9 match)
  #:use-module (ice-9 format)
  #:use-module (ice-9 ftw)
  #:use-module (json)
  #:use-module (shepherd comm)
  #:use-module (srfi srfi-1)
  #:export (validate-policy read-policy service-state service-details
            shepherd-request dispatch main))

(define (fail code message)
  (throw 'management-error code message))

(define (absolute-path? path)
  (and (string? path) (string-prefix? "/" path)))

(define (service-name? name)
  (and (string? name) (positive? (string-length name))
       (not (member name '("root" "shepherd")))
       (every (lambda (char)
                (or (char<=? #\a char #\z) (char<=? #\A char #\Z)
                    (char<=? #\0 char #\9) (memv char '(#\_ #\-))))
              (string->list name))))

(define (validate-policy policy)
  (unless (and (list? policy)
               (every (lambda (item) (and (pair? item) (symbol? (car item)))) policy)
               (= (length policy) (length (delete-duplicates (map car policy))))
               (every (lambda (key) (memq key '(version socket moonraker-service services power)))
                      (map car policy))
               (equal? (assq-ref policy 'version) 1)
               (absolute-path? (assq-ref policy 'socket))
               (service-name? (assq-ref policy 'moonraker-service)))
    (fail "policy" "Invalid management policy header"))
  (let ((services (assq-ref policy 'services))
        (power (assq-ref policy 'power))
        (own (assq-ref policy 'moonraker-service)))
    (unless (and (list? services)
                 (every (lambda (entry)
                          (and (pair? entry) (service-name? (car entry))
                               (list? (cdr entry))
                               (every (lambda (action) (memq action '(start stop restart)))
                                      (cdr entry))
                               (= (length (cdr entry))
                                  (length (delete-duplicates (cdr entry))))
                               (or (not (equal? (car entry) own))
                                   (every (lambda (action) (eq? action 'restart)) (cdr entry)))))
                        services)
                 (= (length services) (length (delete-duplicates (map car services))))
                 (assoc own services)
                 (list? power)
                 (every (lambda (action) (memq action '(poweroff halt reboot))) power)
                 (= (length power) (length (delete-duplicates power))))
      (fail "policy" "Invalid service or power permissions")))
  policy)

(define (check-policy-path path)
  ;; Check every ancestor too: an unwritable file in a writable directory can
  ;; be replaced. Canonical store paths avoid symlink races and policy aliases.
  (unless (and (absolute-path? path) (equal? path (canonicalize-path path)))
    (fail "policy" "Policy must use an absolute canonical path without symlinks"))
  (let loop ((file path))
    (let* ((info (lstat file)) (mode (stat:perms info)))
      (unless (and (= (stat:uid info) (geteuid))
                   (or (zero? (logand mode #o022))
                       (and (eq? (stat:type info) 'directory)
                            (not (zero? (logand mode #o1000))))))
        ;; Non-root users may traverse root-owned, unwritable ancestors.
        (unless (and (not (equal? file path)) (= 0 (stat:uid info))
                     (or (zero? (logand mode #o022))
                         (and (eq? (stat:type info) 'directory)
                              (not (zero? (logand mode #o1000))))))
          (fail "policy" "Policy and ancestors must be owned by the helper user and protected from replacement"))))
    (unless (equal? file "/") (loop (dirname file))))
  (unless (eq? (stat:type (lstat path)) 'regular)
    (fail "policy" "Policy must be a regular file")))

(define (read-policy path)
  (check-policy-path path)
  (call-with-input-file path
    (lambda (port)
      (let ((policy (read port)))
        (unless (eof-object? (read port))
          (fail "policy" "Expected exactly one policy expression"))
        (validate-policy policy)))))

(define (field properties key default)
  (match (assq key properties)
    ((_ value) value)
    (_ default)))

(define (service-properties service)
  (match service
    (('service ('version 0 _ ...) properties ...) properties)
    (_ (fail "protocol" "Unsupported Shepherd service representation"))))

(define (service-state service)
  (let* ((props (service-properties service))
         (running (field props 'running #f))
         (status (field props 'status (if running 'running 'stopped)))
         (failures (field props 'startup-failures '()))
         (changes (field props 'status-changes '()))
         (exits (field props 'exit-statuses '()))
         (last-running (filter-map (lambda (change)
                                     (and (eq? (car change) 'running) (cdr change))) changes))
         (failed? (or (and (pair? failures)
                           (or (null? last-running) (> (car failures) (apply max last-running))))
                      (and (not (field props 'enabled? #t)) (pair? exits)
                           (not (zero? (caar exits)))))))
    (case status
      ((running) '(("active_state" . "active") ("sub_state" . "running")))
      ((starting) '(("active_state" . "activating") ("sub_state" . "starting")))
      ((stopping) '(("active_state" . "deactivating") ("sub_state" . "stopping")))
      ((stopped) (if failed?
                     '(("active_state" . "failed") ("sub_state" . "failed"))
                     '(("active_state" . "inactive") ("sub_state" . "dead"))))
      (else '(("active_state" . "unknown") ("sub_state" . "unknown"))))))

(define (service-pid service)
  (match (field (service-properties service) 'running #f)
    ((? integer? pid) pid)              ;Shepherd < 1.0
    (('process ('version 0 _ ...) properties ...)
     (field properties 'id 'null))
    (_ 'null)))

(define (service-details service actions)
  (let ((props (service-properties service)))
    (append (service-state service)
            `(("pid" . ,(service-pid service))
              ("actions" . ,(list->vector (map symbol->string actions)))
              ("properties" . (("Requires" . ,(list->vector
                                                (map symbol->string (field props 'requires '()))))
                                ("Description" . ,(field props 'docstring ""))))))))

(define (shepherd-request policy action service)
  (let ((socket (open-connection (assq-ref policy 'socket))))
    (dynamic-wind
      (const #t)
      (lambda ()
        (write-command (shepherd-command action service #:directory "/") socket)
        (match (read socket)
          (('reply ('version 0 _ ...) ('result result) ('error error) ('messages messages))
           (when error
             (fail "shepherd" (format #f "Shepherd rejected ~a ~a: ~s" action service error)))
           (if (memq action '(status restart power-off halt))
               (match result
                 ((value) value)
                 (_ (fail "protocol" "Expected a singleton Shepherd action result")))
               result))
          (_ (fail "protocol" "Missing or unsupported Shepherd reply"))))
      (lambda () (close-port socket)))))

(define (find-service services name)
  (find (lambda (service)
          (memq (string->symbol name)
                (field (service-properties service) 'provides '()))) services))

(define (root-service? service)
  (any (lambda (name) (memq name '(root shepherd)))
       (field (service-properties service) 'provides '())))

(define (depends-on? services service target visited)
  (let ((names (field (service-properties service) 'provides '())))
    (and (not (any (lambda (name) (memq name visited)) names))
         (any (lambda (name)
                (or (memq name (field (service-properties target) 'provides '()))
                    (let ((dependency (find-service services (symbol->string name))))
                      (and dependency (depends-on? services dependency target (append names visited))))))
              (field (service-properties service) 'requires '())))))

(define (queue-operation thunk)
  ;; A separate session survives make-kill-destructor's process-group signal.
  ;; Wait for the detachment handshake before acknowledging the request.
  (let* ((ports (pipe)) (pid (primitive-fork)))
    (if (zero? pid)
        (begin
          (close-port (car ports))
          (setsid)
          (if (positive? (primitive-fork))
              (primitive-exit 0)
              (begin
                (let ((null (open-fdes "/dev/null" O_RDWR)))
                  (for-each (lambda (fd) (dup2 null fd)) '(0 1 2))
                  (close-fdes null))
                (write #t (cdr ports))
                (force-output (cdr ports))
                (close-port (cdr ports))
                (usleep 500000)
                (catch #t thunk
                  (lambda args
                    (call-with-syslog-port
                     (lambda (port)
                       (format port "<27>moonraker-shepherd: detached operation failed: ~s~%" args)))))
                (primitive-exit 0))))
        (begin
          (close-port (cdr ports))
          (let ((ready (read (car ports))))
            (close-port (car ports))
            (waitpid pid)
            (unless (eq? ready #t) (fail "helper" "Could not detach management operation"))))))
  '(("accepted" . #t)))

(define* (dispatch policy args #:key (request shepherd-request) (queue queue-operation))
  (define (inventory) (request policy 'status 'root))
  (define (capabilities)
    `(("power" . ,(list->vector (map symbol->string (assq-ref policy 'power))))
      ("moonraker_service" . ,(assq-ref policy 'moonraker-service))
      ("services" . ,(if (null? (assq-ref policy 'services)) (make-hash-table)
                          (map (lambda (entry)
                                 (cons (car entry) (list->vector (map symbol->string (cdr entry)))))
                               (assq-ref policy 'services))))))
  (match args
    (("capabilities") (capabilities))
    (("status")
     (let* ((services (inventory))
            (details (filter-map
                      (lambda (entry)
                        (let ((service (find-service services (car entry))))
                          (and service (not (root-service? service))
                               (cons (car entry) (service-details service (cdr entry))))))
                      (assq-ref policy 'services))))
       `(("services" . ,(if (null? details) (make-hash-table) details)))))
    (((or "start" "stop" "restart") name)
     (let* ((action (string->symbol (car args)))
            (entry (assoc name (assq-ref policy 'services))))
       (unless (and entry (memq action (cdr entry)))
         (fail "denied" "Service action is not permitted by policy"))
        (let* ((services (inventory)) (target (find-service services name))
               (own (find-service services (assq-ref policy 'moonraker-service))))
          (define (perform)
            (let ((result (request policy action (string->symbol name))))
              ;; A failed constructor may return #f without a protocol error.
              (when (and (memq action '(start restart)) (not result))
                (fail "shepherd" "Service failed to start"))
              (when (memq action '(start restart))
                ;; Shepherd's restart action can return #t even if a start
                ;; constructor failed. Verify the resulting state as well.
                (let ((current (find-service (inventory) name)))
                  (unless (and current
                               (or (equal? (assoc-ref (service-state current) "active_state") "active")
                                   (field (service-properties current) 'one-shot? #f)))
                    (fail "shepherd" "Service did not reach the running state"))))
              '(("accepted" . #f))))
          (unless target (fail "not-found" "Service is not registered with Shepherd"))
          (when (root-service? target) (fail "denied" "The root service cannot be managed as an ordinary service"))
          (when (and own (equal? own target) (not (eq? action 'restart)))
            (fail "denied" "Moonraker only supports restart, including through service aliases"))
         (when (and (memq action '(stop restart)) own (not (equal? own target))
                    (depends-on? services own target '()))
           (fail "denied" "Moonraker depends on this service; remove its hard Shepherd requirement first"))
          (if (and own (equal? own target))
             (queue perform)
             (perform)))))
    (((or "poweroff" "halt" "reboot"))
     (let ((action (string->symbol (car args))))
       (unless (memq action (assq-ref policy 'power))
         (fail "denied" "Power action is not permitted by policy"))
       ;; Confirm the connection before acknowledging a detached power request.
       (inventory)
       (queue (lambda ()
                (request policy (case action ((poweroff) 'power-off) ((reboot) 'stop) (else 'halt)) 'root)))))
    (_ (fail "denied" "Unsupported management command or arguments"))))

(define (emit value)
  (scm->json value (current-output-port))
  (newline)
  (force-output))

(define (main args)
  (catch #t
    (lambda ()
      (match args
        ((policy command rest ...)
         (let ((result (dispatch (read-policy policy) (cons command rest))))
           (emit `(("protocol" . 1) ("ok" . #t) ("result" . ,result)))
           0))
        (_ (fail "denied" "Usage: moonraker-shepherd POLICY COMMAND [SERVICE]"))))
    (lambda (key . args)
      (let ((code (if (eq? key 'management-error) (car args) "helper"))
            (message (if (eq? key 'management-error) (cadr args)
                         (format #f "Management operation failed: ~s ~s" key args))))
        (emit `(("protocol" . 1) ("ok" . #f)
                ("error" . (("code" . ,code) ("message" . ,message)))))
        1))))
